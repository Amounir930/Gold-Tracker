  "journal": [
    {
      "id": "r_1",
      "title": "التوقف الفوري بعد خسارتين متتاليتين",
      "content": "في حال حدوث صفقتين خاسرتين في نفس اليوم، يتم إغلاق الشاشة والعودة في اليوم التالي.",
      "category": "psychology",
      "createdAt": "2026-09-02T10:00:00Z"
    },
    {
      "id": "r_2",
      "title": "الالتزام بنسبة 1:2 في الذهب",
      "content": "عدم الدخول في أي صفقة إلا إذا كان الهدف ضعف وقف الخسارة على الأقل.",
      "category": "strategy",
      "createdAt": "2026-09-02T10:00:00Z"
    },
    {
      "id": "r_3",
      "title": "الخسارة جزء من اللعبة وليست نهايتها",
      "content": "حتى أفضل المتداولين يخسرون 40% من صفقاتهم. المهم أن يكون متوسط الربح أكبر من متوسط الخسارة. لا تحكم على نفسك من صفقة واحدة بل من نتائج 20 صفقة.",
      "category": "psychology",
      "createdAt": "2026-09-27T05:00:00Z"
    },
    {
      "id": "r_4",
      "title": "قاعدة الـ 2%: لا تخاطر بأكثر من 2% من الحساب",
      "content": "في كل صفقة، حدد وقف الخسارة بحيث لا تتجاوز الخسارة القصوى 2% من إجمالي رصيد الحساب. هذا يضمن البقاء في السوق حتى بعد سلسلة خسائر متتالية.",
      "category": "risk",
      "createdAt": "2026-09-27T05:01:00Z"
    },
    {
      "id": "r_5",
      "title": "لا تطارد السعر بعد فوات الدخول",
      "content": "إذا فاتك مستوى الدخول المحدد مسبقاً، لا تدخل بسعر أسوأ. انتظر فرصة جديدة. مطاردة السعر تقلل نسبة المكافأة وتزيد المخاطرة.",
      "category": "mistake",
      "createdAt": "2026-09-27T05:02:00Z"
    },
    {
      "id": "r_6",
      "title": "التداول مع الاتجاه العام (الترند) فقط",
      "content": "في الذهب XAUUSD، تحقق دائماً من الاتجاه على الإطار الزمني الأكبر (4 ساعات أو يومي) قبل الدخول. تداول مع الاتجاه يرفع احتمال النجاح بشكل كبير.",
      "category": "strategy",
      "createdAt": "2026-09-27T05:03:00Z"
    },
    {
      "id": "r_7",
      "title": "وقف الخسارة ليس اختيارياً بل هو حماية رأس المال",
      "content": "كل صفقة بدون وقف خسارة هي مقامرة وليست تداول. ضع وقف الخسارة قبل الدخول وليس بعده، ولا تحركه في اتجاه الخسارة أبداً.",
      "category": "risk",
      "createdAt": "2026-09-27T05:04:00Z"
    },
    {
      "id": "r_8",
      "title": "تجنب التداول أثناء الأخبار القوية",
      "content": "بيانات الوظائف الأمريكية (NFP)، قرارات الفائدة، ومؤشر التضخم تسبب تقلبات عنيفة في الذهب. لا تفتح صفقات جديدة قبل 30 دقيقة من الخبر أو أثناءه.",
      "category": "mistake",
      "createdAt": "2026-09-27T05:05:00Z"
    },
    {
      "id": "r_9",
      "title": "كل يوم أخضر هو انتصار يستحق الاحتفال",
      "content": "حتى لو كان الربح صغيراً (5$ أو 10$)، فإن الإغلاق على ربح يعني أنك تقدمت خطوة. الاستمرارية في الأيام الخضراء الصغيرة أقوى من ربح كبير يتبعه خسارة أكبر.",
      "category": "psychology",
      "createdAt": "2026-09-27T05:06:00Z"
    },
    {
      "id": "r_10",
      "title": "التوثيق اليومي هو مفتاح التطور",
      "content": "سجل كل صفقة بسببها ونتيجتها. بعد أسبوعين ستبدأ في رؤية أنماط واضحة: أي أوقات تربح فيها أكثر، وأي أخطاء تتكرر. هذا المتتبع موجود لهذا السبب بالذات.",
      "category": "psychology",
      "createdAt": "2026-09-27T05:07:00Z"
    }
  ]
}